# Backend Environment Variables for Render
# Copy this to .env and fill in your values

# Django Settings
SECRET_KEY=your-secret-key-here-generate-with-python-c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DEBUG=False
ALLOWED_HOSTS=your-app.onrender.com,localhost,127.0.0.1

# Database (auto-configured by Render when you add a PostgreSQL database)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Template Files (you must upload these to Render Disk or use cloud storage)
# MLCIS_SCORING_TEMPLATE=/path/to/G4-G6 Scoring System Final 2024-2025-MLCIS -6A.xlsm
# MLCIS_QUARTER_REPORT_TEMPLATE=/path/to/1- F- Quarter Report Card Grade G4-6 - MLCIS (3).docx
# MLCIS_SEMESTER_REPORT_TEMPLATE=/path/to/2- F- SEM1 and Q2 Report Card G4-6.docx
# MLCIS_END_YEAR_REPORT_TEMPLATE=/path/to/4- F- End of Year Report Card G4-6.docx

# Job retention in seconds (default 600 = 10 minutes)
MLCIS_JOB_RETENTION_SECONDS=600