# Django Settings
SECRET_KEY=django-insecure-dev-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (uses SQLite by default for local dev)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Templates use the portable copies in backend/templates/grade6 by default.
# Leave these unset unless you are deliberately replacing an approved template.
# MLCIS_SCORING_TEMPLATE=D:\path\to\approved-template.xlsm
# MLCIS_QUARTER_REPORT_TEMPLATE=D:\path\to\approved-template.docx

# Job retention in seconds (default 600 = 10 minutes)
MLCIS_JOB_RETENTION_SECONDS=600
